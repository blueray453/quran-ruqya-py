{"key": "2:285", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1, 2], "en": "The Messenger believed", "bn": "ঈমান এনেছেন রাসূল"}, {"words": [3, 4, 5], "en": "in what was revealed to him", "bn": "যা তাঁর প্রতি অবতীর্ণ করা হয়েছে"}, {"words": [6, 7], "en": "from his Lord,", "bn": "তাঁর রবের পক্ষ থেকে,"}, {"words": [8], "en": "and so did the believers.", "bn": "এবং মুমিনগণও।"}], [{"words": [9, 10], "en": "All of them believed", "bn": "প্রত্যেকেই ঈমান এনেছে"}, {"words": [11], "en": "in Allah,", "bn": "আল্লাহর উপর,"}, {"words": [12], "en": "His angels,", "bn": "তাঁর ফেরেশতাগণ,"}, {"words": [13], "en": "His books,", "bn": "তাঁর কিতাবসমূহ"}, {"words": [14], "en": "and His messengers.", "bn": "এবং তাঁর রাসূলগণের উপর।"}], [{"words": [15, 16, 17, 18, 19, 20], "en": "“We make no distinction between any of His messengers.”", "bn": "আমরা তাঁর রাসূলগণের কারও মধ্যে তারতম্য করি না।"}], [{"words": [21, 22], "en": "And they say, “We hear", "bn": "আর তারা বলে: আমরা শুনেছি"}, {"words": [23], "en": "and we obey.", "bn": "ও মেনে নিয়েছি।"}], [{"words": [24, 25], "en": "Your forgiveness, our Lord,", "bn": "হে আমাদের রব! আপনার ক্ষমা প্রার্থনা করি"}, {"words": [26, 27], "en": "and to You is the final return.”", "bn": "এবং আপনার দিকেই প্রত্যাবর্তনস্থল।"}]], "coarse": true, "reasons": ["clauses"], "refined": true}