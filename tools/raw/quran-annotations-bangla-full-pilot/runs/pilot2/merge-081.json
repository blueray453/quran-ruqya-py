{"81:1": [[{"words": [1], "en": "When", "bn": "যখন"}], [{"words": [2], "en": "the sun", "bn": "সূর্য"}, {"words": [3], "en": "is wrapped up,", "bn": "নিষ্প্রভ হবে,"}]], "81:2": [[{"words": [1], "en": "And when", "bn": "এবং যখন"}], [{"words": [2], "en": "the stars", "bn": "তারকাগুলো"}, {"words": [3], "en": "fall, losing their luster,", "bn": "খসে পড়বে,"}]], "81:3": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the mountains", "bn": "পাহাড়গুলো"}, {"words": [3], "en": "are moved away,", "bn": "চালানো হবে,"}]], "81:4": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the full-term she-camels", "bn": "পূর্ণগর্ভা উটগুলো"}, {"words": [3], "en": "are left untended,", "bn": "উপেক্ষিত হবে,"}]], "81:5": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the wild beasts", "bn": "বন্য পশুগুলো"}, {"words": [3], "en": "are gathered,", "bn": "একত্র করা হবে,"}]], "81:6": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the seas", "bn": "সাগরগুলোকে"}, {"words": [3], "en": "are set ablaze,", "bn": "অগ্নি-উত্তাল করা হবে,"}]], "81:7": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the souls", "bn": "আত্মাগুলোকে"}, {"words": [3], "en": "are paired,", "bn": "সমগোত্রীয়দের সাথে মিলিয়ে দেয়া হবে,"}]], "81:8": [[{"words": [1], "en": "And when", "bn": "আর যখন"}], [{"words": [2], "en": "the girl buried alive", "bn": "জীবন্ত সমাধিস্থ কন্যাকে"}, {"words": [3], "en": "is asked,", "bn": "জিজ্ঞেস করা হবে,"}]], "81:9": [[{"words": [1, 2], "en": "For what sin", "bn": "কোন অপরাধে"}], [{"words": [3], "en": "was she killed?", "bn": "তাকে হত্যা করা হয়েছিল?"}]], "81:10": [[{"words": [1], "en": "And when", "bn": "আর যখন"}, {"words": [2], "en": "the pages", "bn": "আমলনামাগুলো"}, {"words": [3], "en": "are laid open,", "bn": "উন্মোচিত করা হবে,"}]], "81:11": [[{"words": [1], "en": "And when", "bn": "আর যখন"}, {"words": [2], "en": "the sky", "bn": "আসমানের"}, {"words": [3], "en": "is stripped away,", "bn": "আবরণ অপসারিত করা হবে,"}]], "81:12": [[{"words": [1], "en": "And when", "bn": "আর যখন"}, {"words": [2], "en": "Hellfire", "bn": "জাহান্নামকে"}, {"words": [3], "en": "is set ablaze,", "bn": "ভীষণভাবে প্রজ্জ্বলিত করা হবে,"}]], "81:13": [[{"words": [1], "en": "And when", "bn": "আর যখন"}, {"words": [2], "en": "Paradise", "bn": "জান্নাত"}, {"words": [3], "en": "is brought near,", "bn": "নিকটবর্তী করা হবে,"}]], "81:14": [[{"words": [1], "en": "will know", "bn": "জানবে"}, {"words": [2], "en": "a soul", "bn": "প্রত্যেক ব্যক্তি"}], [{"words": [3], "en": "what", "bn": "যা"}, {"words": [4], "en": "it has brought forth.", "bn": "সে উপস্থিত করেছে।"}]], "81:15": [[{"words": [1], "en": "So no!", "bn": "অতএব না!"}], [{"words": [2], "en": "I swear", "bn": "আমি শপথ করছি"}, {"words": [3], "en": "by the planets that recede,", "bn": "পশ্চাদপসরণকারী নক্ষত্রের,"}]], "81:16": [[{"words": [1], "en": "that run", "bn": "যা চলমান"}, {"words": [2], "en": "and disappear.", "bn": "ও অদৃশ্যমান।"}]], "81:17": [[{"words": [1], "en": "By the night", "bn": "শপথ রাতের"}], [{"words": [2, 3], "en": "when it departs.", "bn": "যখন তা শেষ হয়।"}]], "81:18": [[{"words": [1], "en": "And by the dawn", "bn": "শপথ প্রভাতের"}], [{"words": [2, 3], "en": "when it breathes.", "bn": "যখন তার আবির্ভাব হয়।"}]], "81:19": [[{"words": [1], "en": "Indeed, it", "bn": "নিশ্চয়ই এ কুরআন"}], [{"words": [2, 3, 4], "en": "is the word of a noble Messenger.", "bn": "সম্মানিত রাসূলের আনীত বাণী।"}]], "81:20": [[{"words": [1, 2], "en": "Possessor of power", "bn": "সম্পন্ন শক্তি"}], [{"words": [3], "en": "with", "bn": "কাছে"}, {"words": [4, 5], "en": "the Owner of the Throne,", "bn": "আরশের অধিপতির"}, {"words": [6], "en": "secure", "bn": "মর্যাদা সম্পন্ন"}]], "81:21": [[{"words": [1], "en": "Obeyed", "bn": "মান্য করা হয়"}], [{"words": [2, 3], "en": "there and trustworthy.", "bn": "সেখানে, (এবং সে) বিশ্বস্ত।"}]], "81:22": [[{"words": [1, 2], "en": "And your companion", "bn": "আর তোমাদের সাথী"}], [{"words": [3], "en": "is not mad.", "bn": "উন্মাদ নন।"}]], "81:23": [[{"words": [1, 2], "en": "And he has certainly seen him", "bn": "এবং নিশ্চয়ই তিনি তাকে দেখেছেন"}], [{"words": [3, 4], "en": "on the clear horizon.", "bn": "স্পষ্ট দিগন্তে।"}]], "81:24": [[{"words": [1, 2], "en": "And he is not", "bn": "আর তিনি নন"}], [{"words": [3, 4], "en": "withholding regarding the unseen", "bn": "গায়েবী বিষয় সম্পর্কে"}], [{"words": [5], "en": "a withholder.", "bn": "কৃপণ।"}]], "81:25": [[{"words": [1, 2], "en": "And it is not", "bn": "আর এটা নয়"}, {"words": [3, 4], "en": "the word of a devil,", "bn": "কোনো শয়তানের বাক্য"}, {"words": [5], "en": "expelled [from the heavens].", "bn": "অভিশপ্ত।"}]], "81:26": [[{"words": [1, 2], "en": "So where are you going?", "bn": "কাজেই তোমরা কোথায় যাচ্ছ?!"}]], "81:27": [[{"words": [1, 2], "en": "It is not", "bn": "এ তো নয়"}, {"words": [3, 4], "en": "except a reminder", "bn": "শুধু উপদেশ"}, {"words": [5], "en": "to the worlds,", "bn": "সৃষ্টিকুলের জন্য,"}]], "81:28": [[{"words": [1], "en": "For whoever", "bn": "তার জন্যে যে"}, {"words": [2], "en": "wills", "bn": "চায়"}, {"words": [3], "en": "among you", "bn": "তোমাদের মধ্যে"}, {"words": [4, 5], "en": "to take a straight course.", "bn": "সরল পথে চলতে।"}]], "81:29": [[{"words": [1, 2], "en": "And you do not will", "bn": "আর তোমরা ইচ্ছে করতে পার না"}], [{"words": [3], "en": "except", "bn": "এ ছাড়া"}, {"words": [4, 5], "en": "that", "bn": "যে"}, {"words": [6], "en": "Allah", "bn": "আল্লাহ"}], [{"words": [7, 8], "en": "wills, Lord of the worlds.", "bn": "চান, সৃষ্টিকুলের রব।"}]]}