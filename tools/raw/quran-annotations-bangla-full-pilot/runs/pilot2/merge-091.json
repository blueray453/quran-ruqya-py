{"91:1": [[{"words": [1], "en": "By the sun", "bn": "শপথ সূর্যের"}, {"words": [2], "en": "and its brightness,", "bn": "এবং তার কিরণের,"}]], "91:2": [[{"words": [1], "en": "and by the moon", "bn": "শপথ চাঁদের,"}], [{"words": [2, 3], "en": "when it follows it", "bn": "যখন তা সূর্যের পর আবির্ভূত হয়,"}]], "91:3": [[{"words": [1], "en": "and by the day", "bn": "শপথ দিনের,"}], [{"words": [2, 3], "en": "when it displays it", "bn": "যখন সে সূর্যকে প্রকাশ করে,"}]], "91:4": [[{"words": [1], "en": "and by the night", "bn": "শপথ রাতের,"}], [{"words": [2, 3], "en": "when it covers it", "bn": "যখন সে সূর্যকে আচ্ছাদিত করে,"}]], "91:5": [[{"words": [1], "en": "and by the sky", "bn": "শপথ আকাশের"}], [{"words": [2, 3], "en": "and by Him who built it,", "bn": "এবং যিনি তা নির্মাণ করেছেন তাঁর,"}]], "91:6": [[{"words": [1], "en": "and by the earth", "bn": "শপথ জমিনের"}], [{"words": [2, 3], "en": "and by Him who spread it,", "bn": "এবং যিনি তা বিস্তৃত করেছেন তাঁর,"}]], "91:7": [[{"words": [1], "en": "and by the soul", "bn": "শপথ মানুষের"}], [{"words": [2, 3], "en": "and by Him who proportioned it,", "bn": "এবং যিনি তাকে সুঠাম করেছেন তাঁর,"}]], "91:8": [[{"words": [1], "en": "and inspired it", "bn": "অতঃপর তাকে জ্ঞান দিয়েছেন"}, {"words": [2], "en": "with its wickedness", "bn": "তার মন্দকাজের"}, {"words": [3], "en": "and its righteousness.", "bn": "ও তার তাকওয়ার জ্ঞান।"}]], "91:9": [[{"words": [1, 2], "en": "Indeed, he succeeds", "bn": "নিশ্চয়ই সফল হলো"}], [{"words": [3, 4], "en": "who purifies it,", "bn": "যে নিজেকে পবিত্র করলো,"}]], "91:10": [[{"words": [1, 2], "en": "And indeed, he fails", "bn": "আর নিশ্চয়ই ব্যর্থ হলো"}], [{"words": [3, 4], "en": "who corrupts it.", "bn": "যে নিজেকে কলুষিত করলো।"}]], "91:11": [[{"words": [1, 2], "en": "Thamud denied", "bn": "সামূদ জাতি মিথ্যারোপ করেছিল"}], [{"words": [3], "en": "in their transgression,", "bn": "তাদের অবাধ্যতাবশত,"}]], "91:12": [[{"words": [1, 2], "en": "when", "bn": "যখন"}, {"words": [3], "en": "the most wretched of them was sent forth.", "bn": "তাদের সবচেয়ে হতভাগা ব্যক্তি তৎপর হয়ে উঠলো।"}]], "91:13": [[{"words": [1, 2], "en": "But the Messenger of Allah said to them,", "bn": "অতঃপর আল্লাহর রাসূল তাদেরকে বললো,"}], [{"words": [3, 4], "en": "the Messenger of Allah", "bn": "আল্লাহর রাসূল"}], [{"words": [5, 6], "en": "“(Beware of) the she-camel of Allah", "bn": "“(সাবধান) আল্লাহর উষ্ট্রীকে"}], [{"words": [7], "en": "and her drink.”", "bn": "ও তার পানি পান করানো থেকে।”"}]], "91:14": [[{"words": [1], "en": "But they denied him,", "bn": "কিন্তু তারা তাকে মিথ্যা ভাবলো,"}], [{"words": [2], "en": "and they hamstrung her.", "bn": "অতঃপর তারা তাকে হত্যা করলো।"}], [{"words": [3], "en": "So", "bn": "ফলে"}, {"words": [4], "en": "upon them", "bn": "তাদের উপর"}, {"words": [5], "en": "their Lord", "bn": "তাদের রব"}, {"words": [6], "en": "for their sin", "bn": "তাদের পাপের জন্য"}], [{"words": [7], "en": "and leveled them.", "bn": "অতঃপর তাদেরকে মাটির সাথে সমান করে দিলেন।"}]], "91:15": [[{"words": [1, 2], "en": "And He does not fear", "bn": "আর তিনি ভয় করেন না"}], [{"words": [3], "en": "its consequence.", "bn": "এর পরিণামকে।"}]]}