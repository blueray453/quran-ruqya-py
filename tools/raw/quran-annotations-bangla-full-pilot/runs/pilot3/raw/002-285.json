{"key": "2:285", "model": "anthropic/claude-sonnet-5.5", "clauses": [[{"words": [1, 2], "en": "The Messenger believed", "bn": "রাসূল ঈমান এনেছেন"}], [{"words": [3], "en": "in what", "bn": "তার উপর যা"}, {"words": [4], "en": "was revealed", "bn": "নাযিল করা হয়েছে"}, {"words": [5], "en": "to him", "bn": "তাঁর কাছে"}, {"words": [6, 7], "en": "from his Lord,", "bn": "তাঁর রবের পক্ষ থেকে,"}], [{"words": [8], "en": "and so did the believers.", "bn": "এবং মুমিনগণও।"}], [{"words": [9, 10], "en": "All have believed", "bn": "প্রত্যেকেই ঈমান এনেছে"}, {"words": [11], "en": "in Allah,", "bn": "আল্লাহর উপর,"}, {"words": [12], "en": "and His angels,", "bn": "এবং তাঁর ফেরেশতাগণের উপর,"}, {"words": [13], "en": "and His books,", "bn": "ও তাঁর কিতাবসমূহের উপর,"}, {"words": [14], "en": "and His messengers,", "bn": "এবং তাঁর রাসূলগণের উপর,"}], [{"words": [15, 16], "en": "“We make no distinction", "bn": "‘আমরা কোনো পার্থক্য করি না"}, {"words": [17, 18], "en": "between any one", "bn": "কারও মধ্যে"}, {"words": [19, 20], "en": "of His messengers.”", "bn": "তাঁর রাসূলগণের মধ্য থেকে।’"}], [{"words": [21], "en": "And they say,", "bn": "আর তারা বলে,"}, {"words": [22], "en": "“We hear", "bn": "‘আমরা শুনেছি"}, {"words": [23], "en": "and we obey.", "bn": "এবং মেনে নিয়েছি।"}], [{"words": [24], "en": "We seek Your forgiveness,", "bn": "আপনার ক্ষমা চাই,"}, {"words": [25], "en": "our Lord,", "bn": "হে আমাদের রব,"}], [{"words": [26], "en": "and to You", "bn": "আর আপনারই কাছে"}, {"words": [27], "en": "is the final return.”", "bn": "প্রত্যাবর্তন।’"}]], "coarse": false, "reasons": [], "refined": true, "escalated": true}