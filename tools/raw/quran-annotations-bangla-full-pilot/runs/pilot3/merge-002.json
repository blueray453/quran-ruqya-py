{"2:255": [[{"words": [1], "en": "Allah:", "bn": "আল্লাহ,"}], [{"words": [2, 3], "en": "there is no god", "bn": "কোনো ইলাহ নেই"}, {"words": [4, 5], "en": "except Him,", "bn": "তিনি ছাড়া,"}], [{"words": [6], "en": "the Ever-Living,", "bn": "তিনি চিরঞ্জীব,"}, {"words": [7], "en": "the Sustainer of all existence.", "bn": "সর্বসত্তার ধারক।"}], [{"words": [8, 9], "en": "Neither overtakes Him", "bn": "তাঁকে স্পর্শ করতে পারে না"}, {"words": [10], "en": "drowsiness", "bn": "তন্দ্রা"}, {"words": [11, 12], "en": "nor sleep.", "bn": "আর নিদ্রাও নয়।"}], [{"words": [13], "en": "To Him belongs", "bn": "তাঁরই"}, {"words": [14, 15, 16], "en": "whatever is in the heavens", "bn": "আসমানসমূহে যা কিছু আছে"}, {"words": [17, 18, 19], "en": "and whatever is on the earth.", "bn": "এবং যমীনে যা কিছু আছে।"}], [{"words": [20, 21, 22], "en": "Who is the one who", "bn": "কে সে, যে"}, {"words": [23, 24], "en": "can intercede with Him", "bn": "তাঁর কাছে সুপারিশ করবে"}, {"words": [25, 26], "en": "except by His permission?", "bn": "তাঁর অনুমতি ছাড়া?"}], [{"words": [27], "en": "He knows", "bn": "তিনি জানেন"}, {"words": [28, 29, 30], "en": "what is before them", "bn": "তাদের সামনে যা আছে"}, {"words": [31, 32], "en": "and what is behind them,", "bn": "এবং যা তাদের পিছনে আছে,"}], [{"words": [33, 34], "en": "and they do not encompass", "bn": "আর তারা আয়ত্ত করতে পারে না"}, {"words": [35, 36, 37], "en": "anything of His knowledge", "bn": "তাঁর জ্ঞানের কিছুই"}], [{"words": [38, 39], "en": "except what", "bn": "তবে যা"}, {"words": [40], "en": "He wills.", "bn": "তিনি চান।"}], [{"words": [41], "en": "Extends", "bn": "পরিব্যাপ্ত করে আছে"}, {"words": [42], "en": "His Throne-Seat", "bn": "তাঁর কুরসী"}, {"words": [43], "en": "over the heavens", "bn": "আসমানসমূহকে"}, {"words": [44], "en": "and the earth,", "bn": "ও যমীনকে,"}], [{"words": [45, 46], "en": "and it does not burden Him", "bn": "আর তাঁকে ক্লান্ত করে না"}, {"words": [47], "en": "to guard them both.", "bn": "এ দুটোর রক্ষণাবেক্ষণ।"}], [{"words": [48],