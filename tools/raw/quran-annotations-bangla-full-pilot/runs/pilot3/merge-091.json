{"91:1": [[{"words": [1], "en": "By the sun", "bn": "শপথ সূর্যের"}, {"words": [2], "en": "and its brightness,", "bn": "এবং তার কিরণের,"}]], "91:2": [[{"words": [1], "en": "and by the moon", "bn": "শপথ চাঁদের"}, {"words": [2, 3], "en": "when it follows it,", "bn": "যখন তা সূর্যের পর আবির্ভূত হয়,"}]], "91:3": [[{"words": [1], "en": "and by the day", "bn": "শপথ দিনের"}, {"words": [2, 3], "en": "when it displays it,", "bn": "যখন সে সূর্যকে প্রকাশ করে,"}]], "91:4": [[{"words": [1], "en": "and by the night", "bn": "শপথ রাতের"}, {"words": [2, 3], "en": "when it covers it,", "bn": "যখন সে সূর্যকে আচ্ছাদিত করে,"}]], "91:5": [[{"words": [1], "en": "And by the sky", "bn": "আর আকাশের শপথ"}, {"words": [2], "en": "and by Him who", "bn": "আর তাঁর শপথ যিনি"}, {"words": [3], "en": "constructed it,", "bn": "তা নির্মাণ করেছেন,"}]], "91:6": [[{"words": [1], "en": "and by the earth", "bn": "শপথ পৃথিবীর"}, {"words": [2, 3], "en": "and by He who spread it,", "bn": "এবং যিনি তা বিস্তৃত করেছেন তাঁর,"}]], "91:7": [[{"words": [1], "en": "and by the soul", "bn": "শপথ মানুষের"}, {"words": [2, 3], "en": "and by He who proportioned it,", "bn": "এবং যিনি তাকে সুঠাম করেছেন তাঁর,"}]], "91:8": [[{"words": [1], "en": "Then He inspired it", "bn": "অতঃপর তাকে জ্ঞান দিয়েছেন"}, {"words": [2], "en": "with (knowledge of) its wickedness", "bn": "তার মন্দকাজের"}, {"words": [3], "en": "and its righteousness.", "bn": "ও তার তাকওয়ার।"}]], "91:9": [[{"words": [1, 2], "en": "Indeed, he succeeds", "bn": "নিশ্চয়ই সফল হলো"}, {"words": [3, 4], "en": "who purifies it,", "bn": "যে তাকে পবিত্র করলো,"}]], "91:10": [[{"words": [1, 2], "en": "And indeed, he fails", "bn": "এবং নিশ্চয়ই ব্যর্থ হলো"}, {"words": [3, 4], "en": "who buries it.", "bn": "যে তাকে কলুষিত করলো।"}]], "91:11": [[{"words": [1, 2], "en": "Thamud denied", "bn": "সামূদ জাতি মিথ্যারোপ করেছিল"}, {"words": [3], "en": "by their transgression,", "bn": "তাদের অবাধ্যতাবশত,"}]], "91:12": [[{"words": [1, 2], "en": "when there was sent forth", "bn": "যখন (তৎপর হয়ে) উঠলো"}, {"words": [3], "en": "the most wretched of them.", "bn": "তাদের সবচেয়ে হতভাগা ব্যক্তি।"}]], "91:13": [[{"words": [1], "en": "But said", "bn": "অতঃপর বললো"}, {"words": [2], "en": "to them", "bn": "তাদেরকে"}, {"words": [3], "en": "the Messenger", "bn": "রাসূল"}, {"words": [4], "en": "of Allah", "bn": "আল্লাহর"}], [{"words": [5], "en": "“(Beware of) the she-camel", "bn": "“(সাবধান) উষ্ট্রীর"}, {"words": [6], "en": "of Allah", "bn": "আল্লাহর"}], [{"words": [7], "en": "and her drink.”", "bn": "ও তার পানি পান করানোর বিষয়ে।’"}]], "91:14": [[{"words": [1], "en": "But they denied him,", "bn": "কিন্তু তারা তাকে মিথ্যা ভাবলো,"}], [{"words": [2], "en": "and they hamstrung her.", "bn": "অতঃপর তারা তাকে হত্যা করলো।"}], [{"words": [3, 4, 5], "en": "So their Lord destroyed them", "bn": "ফলে তাদের রব তাদেরকে ধ্বংস করে দিলেন"}, {"words": [6], "en": "for their sin,", "bn": "তাদের পাপের জন্য,"}, {"words": [7], "en": "and leveled them.", "bn": "অতঃপর তাদেরকে (মাটি) সমান করে দিলেন।"}]], "91:15": [[{"words": [1, 2], "en": "And He does not fear", "bn": "আর তিনি ভয় করেন না"}, {"words": [3], "en": "its consequence.", "bn": "এর পরিণামকে।"}]]}