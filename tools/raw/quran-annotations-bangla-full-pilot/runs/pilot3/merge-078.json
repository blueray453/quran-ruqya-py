ishment,", "bn": "আসন্ন শাস্তি সম্পর্কে;"}], [{"words": [5, 6, 7], "en": "on the Day when a man will see", "bn": "যেদিন মানুষ দেখবে"}, {"words": [8], "en": "what", "bn": "যা"}, {"words": [9, 10], "en": "his hands have sent forth,", "bn": "তার দু'হাত আগে পাঠিয়েছে,"}], [{"words": [11], "en": "and will say", "bn": "এবং বলবে"}, {"words": [12], "en": "the disbeliever,", "bn": "কাফির,"}], [{"words": [13], "en": "“Oh, I wish", "bn": "‘হায়, আমি যদি"}, {"words": [14], "en": "I were", "bn": "হতাম"}, {"words": [15], "en": "dust!”", "bn": "মাটি!’"}]]}