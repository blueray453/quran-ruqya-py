{"78:1": [[{"words": [1], "en": "About what", "bn": "কি সম্পর্কে"}, {"words": [2], "en": "are they asking one another?", "bn": "তারা পরস্পরকে জিজ্ঞাসা করছে?"}]], "78:2": [[{"words": [1, 2], "en": "About the news", "bn": "সংবাদ সম্পর্কে"}, {"words": [3], "en": "the great,", "bn": "মহা,"}]], "78:3": [[{"words": [1, 2, 3], "en": "about which they", "bn": "যে বিষয়ে তারা"}, {"words": [4], "en": "are in disagreement.", "bn": "মতানৈক্য করছে।"}]], "78:4": [[{"words": [1], "en": "No!", "bn": "কখনো না!"}], [{"words": [2], "en": "They will soon know.", "bn": "তারা শীঘ্রই জানতে পারবে।"}]], "78:5": [[{"words": [1, 2], "en": "Then, no!", "bn": "তারপর, কখনো না!"}], [{"words": [3], "en": "They will soon know.", "bn": "তারা শীঘ্রই জানতে পারবে।"}]], "78:6": [[{"words": [1, 2], "en": "Have We not made", "bn": "আমরা কি বানাইনি"}, {"words": [3, 4], "en": "the earth a resting place?", "bn": "ভূমিকে বিছানা স্বরূপ?"}]], "78:7": [[{"words": [1, 2], "en": "And the mountains as pegs?", "bn": "এবং পর্বতসমূহকে কীলক স্বরূপ?"}]], "78:8": [[{"words": [1, 2], "en": "And We created you in pairs,", "bn": "আর আমরা তোমাদেরকে জোড়ায় জোড়ায় সৃষ্টি করেছি,"}]], "78:9": [[{"words": [1, 2], "en": "And We made your sleep", "bn": "এবং আমরা তোমাদের ঘুমকে বানিয়েছি"}, {"words": [3], "en": "a rest.", "bn": "বিশ্রাম।"}]], "78:10": [[{"words": [1, 2], "en": "And We made the night", "bn": "এবং আমরা রাতকে বানিয়েছি"}, {"words": [3], "en": "a covering.", "bn": "আবরণ স্বরূপ।"}]], "78:11": [[{"words": [1, 2], "en": "And We made the day", "bn": "এবং আমরা দিনকে বানিয়েছি"}, {"words": [3], "en": "for livelihood.", "bn": "জীবিকা অর্জনের সময়।"}]], "78:12": [[{"words": [1], "en": "And We constructed", "bn": "এবং আমরা নির্মাণ করেছি"}, {"words": [2, 3, 4], "en": "above you seven strong [heavens].", "bn": "তোমাদের উপরে সুদৃঢ় সাত আকাশ।"}]], "78:13": [[{"words": [1], "en": "And We made", "bn": "এবং আমরা বানিয়েছি"}, {"words": [2, 3], "en": "a burning lamp.", "bn": "উজ্জ্বল প্রদীপ।"}]], "78:14": [[{"words": [1], "en": "And We 