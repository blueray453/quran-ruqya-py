{"67:1": [[{"words": [1, 2], "en": "Blessed is He", "bn": "বড় বরকতময় তিনি"}, {"words": [3, 4], "en": "in whose hand is the dominion,", "bn": "সর্বময় কর্তৃত্ব যাঁর হাতে;"}], [{"words": [5, 6, 7, 8, 9], "en": "and He is over all things competent.", "bn": "আর তিনি সবকিছুর উপর ক্ষমতাবান।"}]], "67:2": [[{"words": [1, 2], "en": "He is the One who created", "bn": "যিনি সৃষ্টি করেছেন"}, {"words": [3, 4], "en": "death and life,", "bn": "মৃত্যু ও জীবন,"}], [{"words": [5, 6, 7, 8], "en": "to test you as to which of you is best in deed;", "bn": "তোমাদেরকে পরীক্ষা করার জন্য --- কে তোমাদের মধ্যে আমলের দিক থেকে উত্তম?"}], [{"words": [9, 10, 11], "en": "and He is the Exalted in Might, the Forgiving.", "bn": "আর তিনি পরাক্রমশালী, ক্ষমাশীল।"}]], "67:3": [[{"words": [1, 2], "en": "He is the One who created", "bn": "তিনিই যিনি সৃষ্টি করেছেন"}, {"words": [3, 4, 5], "en": "seven heavens, one above another.", "bn": "সাত আকাশ, স্তরে স্তরে।"}], [{"words": [6, 7], "en": "You will not see", "bn": "তুমি দেখতে পাবে না"}, {"words": [8, 9, 10], "en": "any flaw in the creation of the Most Gracious.", "bn": "দয়াবানের সৃষ্টিতে কোন অসঙ্গতি।"}], [{"words": [11, 12], "en": "Any fault", "bn": "কোন অসঙ্গতি"}], [{"words": [13, 14], "en": "So return your vision,", "bn": "অতএব ফিরাও দৃষ্টিশক্তি,"}, {"words": [15, 16], "en": "can you see", "bn": "কি দেখতে পাও"}, {"words": [17, 18], "en": "any breach?", "bn": "কোন ত্রুটি?"}]], "67:4": [[{"words": [1], "en": "Then", "bn": "আবার"}, {"words": [2, 3], "en": "return the vision", "bn": "ফিরাও দৃষ্টি"}, {"words": [4], "en": "twice again,", "bn": "বার বার,"}], [{"words": [5, 6], "en": "and it will return to you,", "bn": "তোমার দিকে ফিরে আসবে,"}, {"words": [7], "en": "the vision,", "bn": "দৃষ্টি,"}], [{"words": [8], "en": "humbled,", "bn": "ব্যর্থ হয়ে,"}, {"words": [9, 10], "en": "while it is fatigued.", "bn": "এবং তা ক্লান্তশ্রান্ত (হবে)।"}]], "67:6": [[{"words": [1, 2, 3], "en": "For those who disbelieved in their Lord,", "bn": "যারা তাদের রবকে অস্বীকার করেছে তাদের জন্যে,"}], [{"words": [4, 5], "en": "is the punishment of Hell;", "bn": "রয়েছে জাহান্নামের শাস্তি;"}], [{"words": [6, 7], "en": "and wretched is the destination.", "bn": "এবং অত্যন্ত খারাপ প্রত্যাবর্তন স্থল।"}]], "67:7": [[{"words": [1, 2, 3], "en": "When they are thrown therein,", "bn": "যখন তারা তার মধ্যে নিক্ষিপ্ত হবে,"}], [{"words": [4, 5, 6], "en": "they will hear from it a inhaling,", "bn": "তখন তারা তার জন্য বিকট শব্দ শুনবে,"}], [{"words": [7, 8], "en": "while it boils up.", "bn": "এবং তা উদ্বেলিত হবে।"}]], "67:8": [[{"words": [1, 2, 3, 4], "en": "It almost bursts from rage.", "bn": "রোষে জাহান্নাম যেন ফেটে পড়ার উপক্রম হবে।"}], [{"words": [5, 6, 7], "en": "Every time a group is thrown into it,", "bn": "যখনই তাতে কোনো দলকে নিক্ষেপ করা হবে,"}], [{"words": [8, 9, 10], "en": "its keepers will ask them,", "bn": "তাদেরকে রক্ষীরা জিজ্ঞেস করবে,"}], [{"words": [11, 12, 13], "en": "“Did there not come to you a warner?”", "bn": "‘তোমাদের কাছে কি কোনো সতর্ককারী আসেনি?’"}]]}