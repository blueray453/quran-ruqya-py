{"key": "67:6", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1, 2, 3], "en": "For those who disbelieved in their Lord,", "bn": "যারা তাদের রবকে অস্বীকার করেছে তাদের জন্যে,"}], [{"words": [4, 5], "en": "is the punishment of Hell;", "bn": "রয়েছে জাহান্নামের শাস্তি;"}], [{"words": [6, 7], "en": "and wretched is the destination.", "bn": "এবং অত্যন্ত খারাপ প্রত্যাবর্তন স্থল।"}]]}