{"67:1": [[{"words": [1], "en": "Blessed is", "bn": "বড় বরকতময়"}, {"words": [2, 3], "en": "He in whose hand", "bn": "সেই সত্তা যাঁর হাতে"}, {"words": [4], "en": "is the dominion,", "bn": "কর্তৃত্ব,"}], [{"words": [5], "en": "and He", "bn": "আর তিনি"}, {"words": [6, 7, 8], "en": "is over all things", "bn": "সবকিছুর উপর"}, {"words": [9], "en": "competent.", "bn": "ক্ষমতাবান।"}]], "67:2": [[{"words": [1, 2], "en": "He who created", "bn": "যিনি সৃষ্টি করেছেন"}, {"words": [3, 4], "en": "death and life", "bn": "মৃত্যু ও জীবন"}], [{"words": [5], "en": "that He may test you:", "bn": "তোমাদেরকে পরীক্ষা করার জন্য:"}], [{"words": [6, 7, 8], "en": "which of you is best in deed.", "bn": "কে তোমাদের মধ্যে আমলে সর্বোত্তম।"}], [{"words": [9, 10, 11], "en": "And He is the Almighty, the Oft-Forgiving.", "bn": "আর তিনি পরাক্রমশালী, ক্ষমাশীল।"}]], "67:3": [[{"words": [1], "en": "The One who", "bn": "তিনিই যিনি"}, {"words": [2], "en": "created", "bn": "সৃষ্টি করেছেন"}], [{"words": [3], "en": "seven", "bn": "সাত"}, {"words": [4], "en": "heavens", "bn": "আকাশ"}, {"words": [5], "en": "in layers.", "bn": "স্তরে স্তরে।"}], [{"words": [6, 7], "en": "You will not see", "bn": "আপনি দেখতে পাবেন না"}], [{"words": [8, 9, 10], "en": "in the creation of the Most Merciful", "bn": "রহমানের সৃষ্টিতে"}], [{"words": [11, 12], "en": "any inconsistency.", "bn": "কোনো খুঁত।"}], [{"words": [13, 14], "en": "So return your vision", "bn": "অতএব আপনি তাকিয়ে দেখুন"}], [{"words": [15, 16], "en": "Do you see", "bn": "দেখতে পান কি"}], [{"words": [17, 18], "en": "any flaw?", "bn": "কোনো ত্রুটি?"}]], "67:4": [[{"words": [1, 2], "en": "Then return", "bn": "তারপর ফিরাও"}, {"words": [3], "en": "the gaze", "bn": "দৃষ্টি"}, {"words": [4], "en": "twice.", "bn": "দুই বার।"}], [{"words": [5], "en": "The gaze will return", "bn": "দৃষ্টি ফিরে আসবে"}, {"words": [6], "en": "to you", "bn": "তোমার দিকে"}, {"words": [7], "en": "the gaze", "bn": "দৃষ্টি"}, {"words": [8], "en": "humbled,", "bn": "ব্যর্থ হয়ে,"}], [{"words": [9, 10], "en": "while it is fatigued.", "bn": "এবং তা ক্লান্তশ্রান্ত।"}]], "67:5": [[{"words": [1, 2, 3, 4], "en": "And We have certainly beautified the nearest heaven", "bn": "আর অবশ্যই আমরা নিকটবর্তী আসমানকে সুশোভিত করেছি"}, {"words": [5], "en": "with lamps,", "bn": "প্রদীপমালা দ্বারা,"}], [{"words": [6, 7, 8], "en": "and made them missiles for the devils,", "bn": "এবং সেগুলোকে শয়তানের প্রতি নিক্ষেপের উপকরণ করেছি,"}], [{"words": [9, 10, 11, 12], "en": "and We have prepared for them the punishment of the Blaze.", "bn": "এবং তাদের জন্য প্রস্তুত রেখেছি জ্বলন্ত আগুনের শাস্তি।"}]], "67:6": [[{"words": [1], "en": "And for those", "bn": "এবং যারা জন্যে"}, {"words": [2], "en": "who disbelieved", "bn": "অস্বীকার করেছে"}, {"words": [3], "en": "in their Lord", "bn": "তাদের রবকে"}], [{"words": [4], "en": "is the punishment", "bn": "শাস্তি"}, {"words": [5], "en": "of Hell,", "bn": "জাহান্নামের।"}], [{"words": [6], "en": "and wretched is", "bn": "এবং অত্যন্ত খারাপ"}, {"words": [7], "en": "the destination.", "bn": "প্রত্যাবর্তন স্থল।"}]], "67:7": [[{"words": [1], "en": "When", "bn": "যখন"}, {"words": [2, 3], "en": "they are thrown into it,", "bn": "তাদেরকে সেখানে নিক্ষেপ করা হবে,"}], [{"words": [4], "en": "they will hear", "bn": "তারা শুনবে"}, {"words": [5], "en": "from it", "bn": "তার থেকে"}, {"words": [6], "en": "a dreadful inhaling", "bn": "বিকট শব্দ"}], [{"words": [7, 8], "en": "while it boils up.", "bn": "আর তা হবে উদ্বেলিত।"}]], "67:8": [[{"words": [1, 2], "en": "It almost bursts", "bn": "উপক্রম হবে ফেটে পড়ার"}, {"words": [3, 4], "en": "apart from rage.", "bn": "রোষে।"}], [{"words": [5, 6], "en": "Every time", "bn": "যখনই"}, {"words": [7, 8], "en": "a group is thrown into it,", "bn": "তার মধ্যে কোন দল নিক্ষিপ্ত হবে,"}], [{"words": [9, 10], "en": "its keepers will ask them,", "bn": "তার রক্ষীরা জিজ্ঞেস করবে তাদের"}], [{"words": [11, 12, 13], "en": "“Did there not come to you a warner?”", "bn": "“নাই কি তোমাদের কাছে আসে সতর্ককারী?”"}]], "67:9": [[{"words": [1], "en": "They will say,", "bn": "তারা বলবে,"}], [{"words": [2], "en": "“Yes,", "bn": "‘হ্যাঁ,"}, {"words": [3, 4], "en": "indeed a warner came to us,", "bn": "অবশ্যই আমাদের কাছে এসেছিল"}, {"words": [5], "en": "a warner,", "bn": "সতর্ককারী,"}], [{"words": [6], "en": "but we denied", "bn": "তবে আমরা মিথ্যারোপ করেছিলাম"}], [{"words": [7], "en": "and we said,", "bn": "এবং বলেছিলাম,"}, {"words": [8, 9, 10], "en": "‘Allah has not sent down", "bn": "‘আল্লাহ নাযিল করেননি"}, {"words": [11, 12], "en": "anything.", "bn": "কিছুই।"}], [{"words": [13, 14], "en": "You are", "bn": "তোমরা তো"}, {"words": [15, 16, 17, 18], "en": "only in great error.’”", "bn": "মহাবিভ্রান্তিতে রয়েছ।’”"}]], "67:10": [[{"words": [1], "en": "And they will say,", "bn": "আর তারা বলবে,"}], [{"words": [2, 3], "en": "“If only we had", "bn": "‘যদি আমরা"}, {"words": [4], "en": "listened", "bn": "শুনতাম"}, {"words": [5], "en": "or", "bn": "অথবা"}, {"words": [6], "en": "reasoned,", "bn": "বিবেক-বুদ্ধি প্রয়োগ করতাম,"}], [{"words": [7, 8, 9], "en": "we would not", "bn": "তাহলে আমরা হতাম না"}, {"words": [10, 11], "en": "be among the companions of the Blaze.”", "bn": "জ্বলন্ত আগুনের অধিবাসী।’"}]], "67:11": [[{"words": [1], "en": "Then they will confess", "bn": "অতঃপর তারা স্বীকার করবে"}, {"words": [2], "en": "their sins.", "bn": "তাদের অপরাধ।"}], [{"words": [3], "en": "So away", "bn": "সুতরাং ধ্বংস"}, {"words": [4, 5], "en": "with the companions of the Blaze!", "bn": "জ্বলন্ত আগুনের অধিবাসীদের জন্য!"}]], "67:12": [[{"words": [1, 2, 3], "en": "Indeed, those who fear", "bn": "নিশ্চয় যারা ভয় করে"}, {"words": [4], "en": "their Lord", "bn": "তাদের রবকে"}, {"words": [5], "en": "unseen,", "bn": "অদেখা অবস্থায়,"}], [{"words": [6, 7], "en": "for them is forgiveness", "bn": "তাদের জন্য রয়েছে ক্ষমা"}, {"words": [8, 9], "en": "and a great reward.", "bn": "এবং মহাপুরস্কার।"}]], "67:13": [[{"words": [1, 2], "en": "And conceal your speech", "bn": "আর তোমরা তোমাদের কথা গোপন কর"}, {"words": [3, 4, 5], "en": "or proclaim it.", "bn": "অথবা প্রকাশ্যে বল।"}], [{"words": [6, 7], "en": "Indeed, He is All-Knowing", "bn": "তিনি তো সম্যক অবগত"}, {"words": [8, 9], "en": "of what is within the breasts.", "bn": "অন্তরসমূহে যা আছে তা সম্পর্কে।"}]], "67:14": [[{"words": [1, 2], "en": "Does not know", "bn": "তিনি কি জানেন না"}, {"words": [3, 4], "en": "He who created?", "bn": "যিনি সৃষ্টি করেছেন?"}], [{"words": [5, 6], "en": "And He is the Subtle,", "bn": "অথচ তিনি সূক্ষ্মদর্শী,"}, {"words": [7], "en": "the All-Aware.", "bn": "সম্যক অবহিত।"}]]}