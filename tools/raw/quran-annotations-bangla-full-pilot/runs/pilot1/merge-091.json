{"91:1": [[{"words": [1], "en": "By the sun", "bn": "শপথ সূর্যের"}], [{"words": [2], "en": "and its brightness.", "bn": "এবং তার কিরণের।"}]], "91:2": [[{"words": [1], "en": "By the moon", "bn": "শপথ চাঁদের"}], [{"words": [2, 3], "en": "when it follows it,", "bn": "যখন তা তার পিছে আসে,"}]], "91:3": [[{"words": [1], "en": "By the day", "bn": "শপথ দিনের"}], [{"words": [2, 3], "en": "when it displays it,", "bn": "যখন তা তাকে প্রকাশ করে,"}]], "91:4": [[{"words": [1], "en": "By the night", "bn": "শপথ রাতের"}], [{"words": [2, 3], "en": "when it covers it,", "bn": "যখন তা তাকে ঢেকে ফেলে,"}]], "91:5": [[{"words": [1], "en": "By the sky", "bn": "শপথ আকাশের"}], [{"words": [2, 3], "en": "and by He who constructed it,", "bn": "এবং যিনি তা তৈরি করেছেন তাঁর,"}]], "91:6": [[{"words": [1], "en": "By the earth", "bn": "শপথ পৃথিবীর"}], [{"words": [2, 3], "en": "and by He who spread it,", "bn": "এবং যিনি তা বিস্তৃত করেছেন তাঁর,"}]], "91:7": [[{"words": [1], "en": "By the soul", "bn": "শপথ মানুষের"}], [{"words": [2, 3], "en": "and by He who proportioned it,", "bn": "এবং যিনি তাকে সুঠাম করেছেন তাঁর,"}]], "91:8": [[{"words": [1, 2], "en": "then He inspired it with its wickedness", "bn": "অতঃপর তাকে তার মন্দকাজের জ্ঞান দিয়েছেন"}], [{"words": [3], "en": "and its righteousness.", "bn": "ও তার তাকওয়ার।"}]], "91:9": [[{"words": [1, 2], "en": "He has succeeded", "bn": "সে সফলকাম হয়েছে"}], [{"words": [3, 4], "en": "who purifies it,", "bn": "যে নিজেকে পবিত্র করেছে,"}]], "91:10": [[{"words": [1, 2], "en": "And he has failed", "bn": "আর সে ব্যর্থ হয়েছে"}], [{"words": [3, 4], "en": "who corrupts it.", "bn": "যে নিজেকে কলুষিত করেছে।"}]], "91:11": [[{"words": [1, 2], "en": "Thamud denied", "bn": "সামূদ সম্প্রদায় মিথ্যারোপ করেছিল"}], [{"words": [3], "en": "by their transgression,", "bn": "তাদের অবাধ্যতাবশত,"}]], "91:12": [[{"words": [1, 2], "en": "when", "bn": "যখন"}], [{"words": [3], "en": "the most wretched of them", "bn": "তাদের সবচেয়ে হতভাগা ব্যক্তি"}]], "91:13": [[{"words": [1], "en": "Then he said", "bn": "অতঃপর বললেন"}, {"words": [2], "en": "to them,", "bn": "তাদেরকে,"}], [{"words": [3, 4], "en": "“the Messenger of Allah", "bn": "‘আল্লাহর রাসূল"}], [{"words": [5, 6], "en": "(beware of) the she-camel of Allah", "bn": "(সাবধান) আল্লাহর উষ্ট্রী"}], [{"words": [7], "en": "and her drink.”", "bn": "ও তার পানি পান করানো নিয়ে।’"}]], "91:14": [[{"words": [1], "en": "But they denied him", "bn": "কিন্তু তারা তাকে মিথ্যা ভাবলো"}], [{"words": [2], "en": "and hamstrung her.", "bn": "এবং উষ্ট্রীকে হত্যা করলো।"}], [{"words": [3, 4, 5], "en": "So their Lord destroyed them", "bn": "ফলে তাদের রব তাদেরকে ধ্বংস করে দিলেন"}], [{"words": [6], "en": "for their sin", "bn": "তাদের পাপের জন্য"}], [{"words": [7], "en": "and leveled them.", "bn": "এবং তাদেরকে সমান করে দিলেন।"}]], "91:15": [[{"words": [1, 2], "en": "And He does not fear", "bn": "আর তিনি ভয় করেন না"}], [{"words": [3], "en": "its consequence.", "bn": "এর পরিণামকে।"}]]}