{"key": "2:255", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1], "en": "Allah", "bn": "আল্লাহ্‌,"}], [{"words": [2, 3], "en": "there is no deity", "bn": "কোনো সত্য ইলাহ নেই"}, {"words": [4, 5], "en": "except Him,", "bn": "তিনি ছাড়া।"}], [{"words": [6, 7], "en": "the Ever-Living, the Sustainer of all that exists.", "bn": "তিনি চিরঞ্জীব, সর্বসত্তার ধারক।"}], [{"words": [8, 9], "en": "Neither overtakes Him", "bn": "তাঁকে স্পর্শ করতে পারে না"}, {"words": [10, 11, 12], "en": "drowsiness nor sleep.", "bn": "তন্দ্রাও নয়, নিদ্রাও নয়।"}], [{"words": [13, 14, 15, 16], "en": "To Him belongs whatever is in the heavens", "bn": "আসমানসমূহে যা রয়েছে সবই তাঁর"}, {"words": [17, 18, 19], "en": "and whatever is on the earth.", "bn": "ও যমীনে যা রয়েছে।"}], [{"words": [20, 21, 22], "en": "Who is it", "bn": "কে সে"}, {"words": [23, 24], "en": "that can intercede with Him", "bn": "যে তাঁর কাছে সুপারিশ করবে"}, {"words": [25, 26], "en": "except by His permission?", "bn": "তাঁর অনুমতি ব্যতীত?"}], [{"words": [27, 28, 29, 30], "en": "He knows what is before them", "bn": "তাদের সামনে যা আছে তা তিনি জানেন"}, {"words": [31, 32], "en": "and what is behind them.", "bn": "ও পেছনে যা আছে।"}], [{"words": [33, 34], "en": "And they do not encompass", "bn": "আর তারা পরিবেষ্টন করতে পারে না"}, {"words": [35, 36, 37], "en": "anything of His knowledge", "bn": "তাঁর জ্ঞানের কোনো কিছুকেই"}, {"words": [38, 39, 40], "en": "except what He wills.", "bn": "তিনি যা ইচ্ছে করেন তা ছাড়া।"}], [{"words": [41, 42], "en": "His Kursī extends", "bn": "তাঁর ‘কুরসী’ পরিব্যাপ্ত করে আছে"}, {"words": [43, 44], "en": "over the heavens and the earth,", "bn": "আসমানসমূহ ও যমীনকে;"}], [{"words": [45, 46], "en": "and their preservation does not tire Him,", "bn": "আর এ দুটোর রক্ষণাবেক্ষণ তাঁর জন্য বোঝা হয় না,"}, {"words": [47], "en": "the guarding of both of them.", "bn": "এ দুটোর রক্ষণাবেক্ষণ।"}], [{"words": [48, 49, 50], "en": "And He is the Most High, the Most Great.", "bn": "আর তিনি সুউচ্চ সুমহান।"}]], "coarse": false, "refined": true}