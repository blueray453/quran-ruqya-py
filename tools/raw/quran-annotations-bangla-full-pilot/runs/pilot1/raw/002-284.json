{"key": "2:284", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1], "en": "To Allah belongs", "bn": "আল্লাহর জন্যই"}, {"words": [2, 3, 4], "en": "whatever is in the heavens", "bn": "যা আছে আসমানসমূহে"}], [{"words": [5, 6, 7], "en": "and whatever is on the earth.", "bn": "ও যা আছে যমীনে।"}], [{"words": [8, 9], "en": "Whether you disclose", "bn": "তোমরা প্রকাশ কর"}, {"words": [10, 11, 12], "en": "what is within yourselves", "bn": "তোমাদের মনে যা আছে"}, {"words": [13, 14], "en": "or conceal it,", "bn": "বা গোপন রাখ,"}], [{"words": [15, 16, 17], "en": "Allah will call you to account for it.", "bn": "আল্লাহ্‌ সেগুলোর হিসেব তোমাদের কাছ থেকে নিবেন।"}], [{"words": [18], "en": "Then He will forgive", "bn": "অতঃপর ক্ষমা করবেন"}, {"words": [19, 20], "en": "whom He wills", "bn": "যাকে ইচ্ছে"}], [{"words": [21, 22, 23], "en": "and He will punish whom He wills,", "bn": "এবং যাকে ইচ্ছে শাস্তি দিবেন।"}], [{"words": [24, 25, 26, 27, 28], "en": "and Allah is over all things competent.", "bn": "আর আল্লাহ্‌ সবকিছুর উপর পূর্ণ ক্ষমতাবান।"}]], "coarse": true, "refined": true}