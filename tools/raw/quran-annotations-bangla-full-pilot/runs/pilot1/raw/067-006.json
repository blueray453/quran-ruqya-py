{"key": "67:6", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1], "en": "And for those", "bn": "এবং যারা জন্যে"}, {"words": [2, 3], "en": "who disbelieved in their Lord", "bn": "তাদের রবকে অস্বীকার করেছে"}], [{"words": [4, 5], "en": "is the punishment of Hell,", "bn": "জাহান্নামের শাস্তি,"}], [{"words": [6, 7], "en": "and wretched is the destination.", "bn": "এবং তা কত মন্দ প্রত্যাবর্তন স্থল!"}]], "coarse": false, "refined": true}