{"key": "67:3", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1], "en": "The One who", "bn": "তিনিই যিনি"}, {"words": [2], "en": "created", "bn": "সৃষ্টি করেছেন"}, {"words": [3, 4], "en": "seven heavens", "bn": "সাত আকাশ"}, {"words": [5], "en": "one above another.", "bn": "স্তরে স্তরে।"}], [{"words": [6, 7], "en": "You will not see", "bn": "আপনি দেখতে পাবেন না"}, {"words": [8, 9, 10], "en": "in the creation of the Most Merciful", "bn": "দয়াময়ের সৃষ্টিতে"}, {"words": [11, 12], "en": "any fault.", "bn": "কোনো খুঁত।"}], [{"words": [13, 14], "en": "So return the vision,", "bn": "অতএব আপনি আবার তাকান,"}], [{"words": [15, 16], "en": "do you see", "bn": "দেখতে পান কি"}, {"words": [17, 18], "en": "any flaw?", "bn": "কোনো ত্রুটি?"}]], "coarse": false, "refined": true}