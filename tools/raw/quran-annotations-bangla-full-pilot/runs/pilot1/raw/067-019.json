{"key": "67:19", "model": "anthropic/claude-haiku-5.5", "clauses": [[{"words": [1, 2], "en": "Do they not see", "bn": "তারা কি লক্ষ্য করে না"}, {"words": [3, 4], "en": "the birds", "bn": "পাখিদের প্রতি"}, {"words": [5], "en": "above them,", "bn": "তাদের উপরে,"}, {"words": [6], "en": "spreading their wings", "bn": "পাখা বিস্তার করে"}, {"words": [7], "en": "and folding them in?", "bn": "ও সংকুচিত করে?"}], [{"words": [8, 9], "en": "None holds them", "bn": "তাদের স্থির রাখেন না"}, {"words": [10, 11], "en": "except the Most Merciful.", "bn": "দয়াময় ছাড়া।"}], [{"words": [12, 13, 14, 15], "en": "Indeed, He is All-Seeing over everything.", "bn": "নিশ্চয় তিনি সবকিছুর সম্যক দ্রষ্টা।"}]], "coarse": false, "refined": false}