{"78:1": [[{"words": [1, 2], "en": "About what are they asking one another?", "bn": "তারা একে অন্যের কাছে কী বিষয়ে জিজ্ঞাসাবাদ করছে?"}]], "78:2": [[{"words": [1, 2], "en": "About the news", "bn": "সংবাদটির বিষয়ে"}, {"words": [3], "en": "—the great one—", "bn": "মহাসংবাদটির"}]], "78:3": [[{"words": [1, 2, 3], "en": "about which they", "bn": "যে বিষয়ে তারা"}, {"words": [4], "en": "are in disagreement.", "bn": "মতানৈক্য করছে।"}]], "78:4": [[{"words": [1], "en": "No!", "bn": "কখনো না,"}], [{"words": [2], "en": "They will soon know.", "bn": "তারা অচিরেই জানতে পারবে;"}]], "78:5": [[{"words": [1], "en": "Then,", "bn": "তারপর আবার বলি,"}], [{"words": [2], "en": "no!", "bn": "কখনো না,"}], [{"words": [3], "en": "They will soon know.", "bn": "তারা অচিরেই জানতে পারবে।"}]], "78:6": [[{"words": [1, 2], "en": "Have We not made", "bn": "আমরা কি বানাইনি"}, {"words": [3], "en": "the earth", "bn": "ভূমিকে"}, {"words": [4], "en": "a resting place?", "bn": "বিছানা স্বরূপ?"}]], "78:7": [[{"words": [1], "en": "And the mountains", "bn": "এবং পর্বতসমূহকে"}, {"words": [2], "en": "as stakes?", "bn": "কীলক স্বরূপ?"}]], "78:8": [[{"words": [1], "en": "And We created you", "bn": "এবং তোমাদেরকে আমরা সৃষ্টি করেছি"}, {"words": [2], "en": "in pairs,", "bn": "জোড়ায় জোড়ায়,"}]], "78:9": [[{"words": [1, 2], "en": "And We made your sleep", "bn": "এবং আমরা তোমাদের ঘুমকে করেছি"}], [{"words": [3], "en": "a means of rest.", "bn": "বিশ্রামের বাহন।"}]], "78:10": [[{"words": [1, 2], "en": "And We made the night", "bn": "এবং আমরা রাতকে করেছি"}], [{"words": [3], "en": "a covering.", "bn": "আবরণ।"}]], "78:11": [[{"words": [1, 2], "en": "And We made the day", "bn": "এবং আমরা দিনকে করেছি"}], [{"words": [3], "en": "a time for livelihood.", "bn": "জীবিকা অর্জনের সময়।"}]], "78:12": [[{"words": [1, 2], "en": "And We constructed above you", "bn": "এবং আমরা তোমাদের উপরে নির্মাণ করেছি"}], [{"words": [3, 4], "en": "seven strong [heavens].", "bn": "সুদৃঢ় সাত আকাশ।"}]], "78:13": [[{"words": [1, 2], "en": "And We made a lamp", "bn": "এবং আমরা একটি প্রদীপ বানিয়েছি"}], [{"words": [3], "en": "burning brightly.", "bn": "উজ্জ্বল প্রদীপ।"}]], "78:14": [[{"words": [1], "en": "And We sent down", "bn": "আর আমরা বর্ষণ করেছি"}, {"words": [2, 3], "en": "from the rain clouds", "bn": "মেঘমালা হতে"}], [{"words": [4], "en": "water", "bn": "প্রচুর বারি,"}, {"words": [5], "en": "pouring abundantly,", "bn": "মুষলধারে,"}]], "78:15": [[{"words": [1, 2], "en": "That We may bring forth thereby", "bn": "যাতে তা দ্বারা আমরা উৎপন্ন করি"}], [{"words": [3, 4], "en": "grain and vegetation.", "bn": "শস্য ও উদ্ভিদ।"}]], "78:16": [[{"words": [1, 2], "en": "And gardens of thick foliage.", "bn": "এবং ঘন সন্নিবিষ্ট উদ্যান।"}]], "78:17": [[{"words": [1], "en": "Indeed,", "bn": "নিশ্চয়ই"}, {"words": [2], "en": "the Day", "bn": "দিন"}, {"words": [3], "en": "of Judgment", "bn": "বিচারের"}], [{"words": [4], "en": "is", "bn": "আছে"}, {"words": [5], "en": "an appointed time -", "bn": "নির্ধারিত"}]], "78:18": [[{"words": [1], "en": "On the Day", "bn": "সেদিন"}, {"words": [2], "en": "when the trumpet", "bn": "যখন ফুঁ দেওয়া হবে"}, {"words": [3, 4], "en": "is blown", "bn": "শিঙ্গায়"}], [{"words": [5], "en": "and you will come", "bn": "তখন তোমরা আসবে"}, {"words": [6], "en": "forth in crowds,", "bn": "দলে দলে,"}]], "78:19": [[{"words": [1, 2], "en": "And the heaven will be opened,", "bn": "আর আকাশ উন্মুক্ত করা হবে,"}], [{"words": [3, 4], "en": "and it will become gateways.", "bn": "ফলে তা হবে বহু দ্বারবিশিষ্ট।"}]], "78:20": [[{"words": [1, 2], "en": "And the mountains will be set in motion,", "bn": "আর পর্বতসমূহকে চালিত করা হবে,"}], [{"words": [3, 4], "en": "and they will become a mirage.", "bn": "ফলে সেগুলো হয়ে যাবে মরীচিকা।"}]], "78:21": [[{"words": [1, 2], "en": "Indeed, Hell", "bn": "নিশ্চয় জাহান্নাম"}], [{"words": [3, 4], "en": "has been lying in wait,", "bn": "ওৎ পেতে অপেক্ষমান;"}]], "78:22": [[{"words": [1], "en": "for the transgressors", "bn": "সীমালঙ্ঘনকারীদের জন্য"}], [{"words": [2], "en": "a place of return.", "bn": "প্রত্যাবর্তনস্থল।"}]], "78:23": [[{"words": [1, 2], "en": "They will remain therein", "bn": "সেখানে তারা অবস্থান করবে"}], [{"words": [3], "en": "for ages.", "bn": "যুগ যুগ ধরে।"}]], "78:24": [[{"words": [1, 2], "en": "They will not taste", "bn": "তারা আস্বাদন করবে না"}, {"words": [3], "en": "therein", "bn": "সেখানে"}, {"words": [4], "en": "any coolness,", "bn": "শীতলতা,"}], [{"words": [5, 6], "en": "nor any drink.", "bn": "না কোনো পানীয়---"}]], "78:25": [[{"words": [1, 2], "en": "Except scalding water", "bn": "ফুটন্ত পানি ছাড়া"}], [{"words": [3], "en": "and [foul] purulence -", "bn": "ও পুঁজ;"}]], "78:26": [[{"words": [1], "en": "A recompense", "bn": "এটাই প্রতিদান"}], [{"words": [2], "en": "appropriate.", "bn": "উপযুক্ত।"}]], "78:27": [[{"words": [1, 2], "en": "Indeed, they were", "bn": "নিশ্চয়ই তারা ছিল"}], [{"words": [3, 4], "en": "not expecting", "bn": "আশা করত না"}, {"words": [5], "en": "an account,", "bn": "হিসাবের,"}]], "78:28": [[{"words": [1], "en": "And they denied", "bn": "আর তারা মিথ্যারোপ করেছিল"}, {"words": [2], "en": "Our Signs", "bn": "আমাদের নিদর্শনগুলোকে"}, {"words": [3], "en": "with [emphatic] denial.", "bn": "সম্পূর্ণ মিথ্যা জ্ঞানে।"}]], "78:29": [[{"words": [1, 2], "en": "And all things,", "bn": "আর সবকিছু"}], [{"words": [3], "en": "We have enumerated", "bn": "আমরা গুনে রেখেছি"}, {"words": [4], "en": "in writing.", "bn": "লিখিতভাবে।"}]], "78:30": [[{"words": [1], "en": "So taste [the penalty],", "bn": "অতএব আস্বাদ গ্রহণ কর,"}], [{"words": [2, 3], "en": "and never will We increase you", "bn": "আমরা তো তোমাদের বাড়াব না"}, {"words": [4, 5], "en": "except in torment.", "bn": "শাস্তি ছাড়া।"}]], "78:31": [[{"words": [1, 2], "en": "Indeed, for the righteous", "bn": "নিশ্চয় মুত্তাকীদের জন্য"}], [{"words": [3], "en": "is attainment,", "bn": "আছে সাফল্য,"}]], "78:32": [[{"words": [1], "en": "gardens", "bn": "উদ্যানসমূহ"}], [{"words": [2], "en": "and grapevines.", "bn": "ও আঙ্গুরসমূহ।"}]], "78:33": [[{"words": [1, 2], "en": "And young women of equal age,", "bn": "আর সমবয়স্কা উদ্ভিন্ন যৌবনা তরুণী,"}]], "78:34": [[{"words": [1, 2], "en": "and a cup full (to the brim).", "bn": "এবং পরিপূর্ণ পানিপাত্র।"}]], "78:35": [[{"words": [1, 2, 3], "en": "They will not hear therein", "bn": "সেখানে তারা শুনবে না"}, {"words": [4], "en": "any vain talk", "bn": "কোনো অসার কথা"}], [{"words": [5, 6], "en": "or any falsehood,", "bn": "ও মিথ্যা বাক্য;"}]], "78:36": [[{"words": [1], "en": "As a reward", "bn": "পুরস্কার হিসেবে"}, {"words": [2, 3], "en": "from your Lord,", "bn": "আপনার রবের পক্ষ থেকে,"}], [{"words": [4], "en": "a gift", "bn": "দানস্বরূপ"}, {"words": [5], "en": "according to account,", "bn": "যথোচিত,"}]], "78:37": [[{"words": [1], "en": "Lord", "bn": "রব"}], [{"words": [2], "en": "of the heavens", "bn": "আকাশসমূহের"}, {"words": [3], "en": "and the earth,", "bn": "ও পৃথিবীর,"}], [{"words": [4, 5], "en": "and whatever is between them,", "bn": "এবং এ দু'য়ের মাঝে যা কিছু আছে,"}], [{"words": [6], "en": "the Most Gracious.", "bn": "অশেষ দয়াবান।"}], [{"words": [7, 8], "en": "They will have no power", "bn": "তারা সক্ষম হবে না"}, {"words": [9, 10], "en": "to address Him.", "bn": "তাঁর সাথে কথা বলতে।"}]], "78:38": [[{"words": [1, 2, 3, 4, 5], "en": "On the Day the Spirit and the angels will stand in rows,", "bn": "সেদিন রূহ্ ও ফেরেশতাগণ সারিবদ্ধভাবে দাঁড়াবে;"}], [{"words": [6, 7], "en": "none will speak", "bn": "সেদিন কেউ কথা বলবে না,"}], [{"words": [8, 9, 10, 11, 12], "en": "except one whom the Most Merciful permits,", "bn": "তবে ‘রহমান’ যাকে অনুমতি দেবেন সে ছাড়া"}], [{"words": [13, 14], "en": "and he will say what is right.", "bn": "এবং সে সঠিক কথা বলবে।"}]], "78:39": [[{"words": [1], "en": "That", "bn": "সে-ই"}, {"words": [2], "en": "is the Day", "bn": "দিন"}, {"words": [3], "en": "the True.", "bn": "সুনিশ্চিত।"}], [{"words": [4, 5], "en": "So whoever wills,", "bn": "অতএব যে চায়,"}], [{"words": [6], "en": "let him take", "bn": "গ্রহণ করুক"}, {"words": [7, 8], "en": "to his Lord", "bn": "তার রবের দিকে"}, {"words": [9], "en": "a way of return.", "bn": "প্রত্যাবর্তনের পথ।"}]], "78:40": [[{"words": [1, 2], "en": "Indeed, We have warned you", "bn": "নিশ্চয়ই আমরা তোমাদেরকে সতর্ক করছি"}, {"words": [3, 4], "en": "of an impending punishment.", "bn": "আসন্ন শাস্তির।"}], [{"words": [5], "en": "On the Day", "bn": "সেদিন"}, {"words": [6, 7], "en": "a man will see", "bn": "মানুষ দেখবে"}, {"words": [8, 9, 10], "en": "what his hands have sent forth,", "bn": "তার দু'হাত যা আগে পাঠিয়েছে,"}], [{"words": [11, 12], "en": "and the disbeliever will say,", "bn": "এবং কাফের বলবে,"}, {"words": [13, 14, 15], "en": "“Oh, I wish I were dust!”", "bn": "“হায় আমার আফসোস, আমি যদি মাটি হতাম!”"}]]}