n": "আল্লাহর কাছে আছে,"}], [{"words": [6, 7], "en": "and I am only", "bn": "আর আমি তো"}], [{"words": [8, 9], "en": "a clear warner.”", "bn": "স্পষ্ট সতর্ককারী মাত্র।’"}]], "67:27": [[{"words": [1, 2], "en": "But when they see it", "bn": "অতঃপর তারা যখন তা দেখবে"}], [{"words": [3], "en": "approaching,", "bn": "নিকটে আসন্ন,"}], [{"words": [4, 5], "en": "the faces", "bn": "মলিন হবে মুখগুলো"}], [{"words": [6, 7], "en": "of those who disbelieved", "bn": "যারা অস্বীকার করেছে তাদের"}], [{"words": [8], "en": "will be distressed, and it will be said,", "bn": "এবং বলা হবে,"}], [{"words": [9, 10, 11, 12, 13], "en": "“This is that which you used to call for.”", "bn": "‘এটাই সেই, যা তোমরা দাবি করতে।’"}]], "67:28": [[{"words": [1], "en": "Say,", "bn": "বল,"}], [{"words": [2], "en": "“Have you considered:", "bn": "‘তোমরা ভেবে দেখেছ কি:"}], [{"words": [3, 4, 5], "en": "if Allah were to destroy me", "bn": "যদি আল্লাহ আমাকে ধ্বংস করেন"}], [{"words": [6, 7], "en": "and those with me,", "bn": "এবং আমার সঙ্গীদেরকে,"}], [{"words": [8, 9], "en": "or have mercy on us,", "bn": "অথবা আমাদের প্রতি দয়া করেন,"}], [{"words": [10, 11, 12], "en": "who then can protect the disbelievers", "bn": "তাহলে কে রক্ষা করবে কাফিরদেরকে"}], [{"words": [13, 14, 15], "en": "from a painful punishment?”", "bn": "যন্ত্রণাদায়ক শাস্তি থেকে?’"}]], "67:29": [[{"words": [1], "en": "Say,", "bn": "বল,"}], [{"words": [2, 3], "en": "“He is the Most Merciful;", "bn": "‘তিনিই পরম করুণাময়;"}], [{"words": [4, 5], "en": "we have believed in Him,", "bn": "আমরা তাঁর প্রতি ঈমান এনেছি,"}], [{"words": [6, 7], "en": "and upon Him we have relied.", "bn": "এবং তাঁরই উপর ভরসা করেছি।"}], [{"words": [8], "en": "And you will come to know", "bn": "অতঃপর শীঘ্রই তোমরা জানবে"}], [{"words": [9, 10, 11, 12, 13], "en": "who it is that is in clear error.”", "bn": "কে স্পষ্ট বিভ্রান্তিতে রয়েছে।’"}]], "67:30": [[{"words": [1], "en": "Say,", "bn": "বলুন,"}, {"words": [2], "en": "“Have you considered:", "bn": "‘তোমরা ভেবে দেখেছ কি:"}], [{"words": [